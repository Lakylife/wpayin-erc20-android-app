    <string name="about_description">Wpayin Wallet is a secure, decentralized wallet for managing cryptocurrency assets. Privacy and security are built in, and private keys never leave your device.</string>
    <string name="about_version">Version</string>
    <string name="about_version_name">Version %1$s</string>
    <string name="about_whats_new">What’s New &amp; Version History</string>
    <string name="about_whats_new_subtitle">See changes in this and earlier releases</string>
    <string name="about_version_history">Version History</string>
    <string name="about_current_version">Current version</string>
    <string name="about_current_release_notes">Balanced trusted-asset filtering keeps scam airdrops hidden while preserving native, bundled, user-added, and market-verified tokens.</string>
    <string name="about_release_notes">Release Notes</string>
    <string name="about_choose_version">Choose a version to see what changed.</string>
    <string name="about_current_badge">CURRENT</string>
    <string name="about_android_112_date">July 22, 2026</string>
    <string name="about_android_112_summary">A trusted-asset filter correction that restores legitimate market-verified tokens.</string>
    <string name="about_android_112_change_1">Restored Explorer-discovered tokens that have a positive market quote for their exact contract.</string>
    <string name="about_android_112_change_2">Unpriced and risk-flagged airdrops remain hidden unless the user explicitly adds the contract.</string>
    <string name="about_android_112_change_3">Kept the same balanced policy across Wallet, You Pay, Swap To, Send and P2P.</string>
    <string name="about_android_111_date">July 22, 2026</string>
    <string name="about_android_111_summary">A security update that keeps unsolicited scam and spam tokens out of the wallet.</string>
    <string name="about_android_111_change_1">Wallet and Swap now show only native coins, bundled verified contracts, and tokens explicitly added by the user.</string>
    <string name="about_android_111_change_2">Explorer-discovered balances can no longer add unknown airdrop tokens to the asset list.</string>
    <string name="about_android_111_change_3">Expanded rejection of explorer reputations including scam, phishing, malicious, suspicious, and unsafe.</string>
    <string name="about_android_111_change_4">Large token balances use compact formatting so You Pay and Swap To remain readable.</string>
    <string name="about_android_110_date">July 22, 2026</string>
    <string name="about_android_110_summary">A settings and usability update bringing the Android wallet closer to the iOS experience.</string>
    <string name="about_android_110_change_1">Redesigned Settings with Show Private Key and a protected Export Wallet flow.</string>
    <string name="about_android_110_change_2">Added persistent notification preferences and the Android wallet-activity notification channel.</string>
    <string name="about_android_110_change_3">Added selectable time zones used by transaction dates and activity grouping.</string>
    <string name="about_android_110_change_4">Added five app color palettes and Cards or Compact asset-list styles.</string>
    <string name="about_android_110_change_5">Made Related Articles open the selected Help Center article with working back navigation.</string>
    <string name="about_android_110_change_6">Redesigned What’s New with Android-specific release notes and version history.</string>
    <string name="about_android_100_date">July 18, 2026</string>
    <string name="about_android_100_summary">The first native Android release of Wpayin Wallet.</string>
    <string name="about_android_100_change_1">Introduced the native Kotlin and Jetpack Compose wallet experience.</string>
    <string name="about_android_100_change_2">Added Wallet Core account derivation and on-device signing for supported networks.</string>
    <string name="about_android_100_change_3">Added encrypted wallet storage backed by Android Keystore.</string>
    <string name="about_android_100_change_4">Added real balances, prices, activity, Send, Receive, Swap and Bridge flows.</string>
    <string name="about_android_100_change_5">Added biometric signing protection, auto-lock, Help Center and network management.</string>
    <string name="about_security_title">Your keys stay yours</string>
    <string name="about_security_message">Wallet data is encrypted locally and protected by Android device security.</string>
